[ui]
theme = "catppuccin-mocha"
poll_rate_ms = 120

[ui.icons]
# 是否在檔名左側顯示檔案類型文字圖示。
enabled = true
# nerd-font 提供緊湊的檔案類型圖示，需要 Terminal 使用 Nerd Font。
# ascii 不需要特殊字型，會顯示 [D] [F] [S] [I] [A] [X]。
style = "nerd-font"

[ui.preview]
height = 8
focus_list_height = 6

[ui.dialog.confirm]
width_percent = 60
height = 5

[ui.dialog.theme_picker]
width_percent = 42
height = 20

[pane]
show_hidden = false
default_sort = "natural"
default_sort_reverse = false

[search]
global_search_limit = 200
global_search_chunk_size = 24
show_loading = true
fzf_follow_links = true

[watcher]
# Finder、Explorer 或其他程式改動目前目錄時，自動刷新所有顯示該目錄的 panel。
enabled = true
# 合併短時間內重複的檔案事件，避免一次操作造成列表連續重載與游標閃動。
debounce_ms = 120
# SMB 掛載點可能不送出原生事件；這個低頻掃描作為跨平台 fallback。
fallback_poll_interval_ms = 2000

[navigation]
fast_move_step = 5
panel_page_step = 10

[behavior]
cancel_search_on_leave = true
