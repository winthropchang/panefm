# ==============================================================================
# `plugins.toml` 設定範例
# ==============================================================================
# 本設定檔提供兩大自訂擴充能力：
# 1. `[[terminals]]`：自訂終端適配器（讓 `wt` / `:terminal` 自動對接特定終端或開新分頁）
# 2. `[[actions.open_with]]`：自訂 `Open with` 外部動作（用自選工具開啟檔案/目錄）
#
# ==============================================================================
# 第一部分：自訂終端適配器 (`[[terminals]]`)
# ==============================================================================
# 當你在 PaneFM 中按下 `wt` 或輸入 `:terminal` 時：
# 系統會優先比對 `[[terminals]]` 列表中的特徵，命中時自動以當前目錄 `{path}` 啟動對應指令。
#
# 🔍 欄位詳細說明：
# - `name`（必填）：終端適配器的識別名稱，例如 `"kitty"`、`"ghostty"`、`"trustview-term"`。
# - `match_env`（選填）：終端軟體自動注入的專屬環境變數清單。只要環境中有其中一個就命中。
#   - WezTerm: `["WEZTERM_PANE", "WEZTERM_EXECUTABLE"]`
#   - Alacritty: `["ALACRITTY_WINDOW_ID", "ALACRITTY_SOCKET"]`
#   - Windows Terminal: `["WT_SESSION", "WT_PROFILE_ID"]`
#   - Kitty: `["KITTY_WINDOW_ID", "KITTY_PID"]`
#   - Ghostty: `["GHOSTTY_RESOURCES_DIR"]`
#   - Warp: `["WARP_IS_LOCAL_SHELL_SESSION"]`
#
# 💡 如何自己查詢當前終端的專屬環境變數（match_env）？
#   在你想測試的終端視窗中直接輸入以下指令，即可看到所有環境變數：
#   - PowerShell（Windows / macOS / Linux）：
#     Get-ChildItem env:
#     （或過濾關鍵字：Get-ChildItem env: | Where-Object { $_.Name -match "TERM|WINDOW|SESSION|PANE" }）
#   - CMD（Windows）：
#     set
#   - Bash / Zsh / Fish（macOS / Linux）：
#     env
#     （或過濾關鍵字：env | grep -iE "term|window|session|pane"）
#
# - `match_process`（選填）：宿主終端軟體的執行檔名稱（不分大小寫）。
#   - 例如：`["ghostty.exe", "ghostty"]`、`["kitty"]`、`["wezterm-gui.exe"]`。
#   - 只要父程序樹符合其中一個名稱就命中（如果你不想查環境變數，直接寫軟體名稱最簡單！）。
# - `command`（選填）：全平台通用的啟動指令範本。
# - `mac_command`（選填）：僅在 macOS 上執行的啟動指令（優先於 `command`）。
# - `windows_command`（選填）：僅在 Windows 上執行的啟動指令（優先於 `command`）。
#
# 📌 佔位符說明：
# - `{path}`：會自動替換為 PaneFM 當前活躍 panel 的完整絕對目錄路徑。
#
# 🛡️ TrustView / 企業安全環境說明：
# 只要 PaneFM 是在 TrustView 保護下啟動，透過 `wt` 喚起的新終端或分頁都會 100% 繼承安全權杖，
# 正常存取保護區檔案。

# 範例 A：macOS Kitty 終端（直接在現有 Kitty 視窗開新 Tab）
# [[terminals]]
# name = "kitty"
# match_env = ["KITTY_WINDOW_ID", "KITTY_PID"]
# match_process = ["kitty"]
# mac_command = "kitty @ launch --type=tab --cwd={path}"

# 範例 B：跨平台 Ghostty 終端（開新視窗並定位到當前目錄）
# [[terminals]]
# name = "ghostty"
# match_env = ["GHOSTTY_RESOURCES_DIR"]
# match_process = ["ghostty.exe", "ghostty"]
# mac_command = "open -a Ghostty {path}"
# windows_command = "ghostty.exe --working-directory {path}"

# 範例 C：跨平台 Warp 終端
# [[terminals]]
# name = "warp"
# match_env = ["WARP_IS_LOCAL_SHELL_SESSION"]
# match_process = ["warp.exe", "warp"]
# mac_command = "open -a Warp {path}"
# windows_command = "warp.exe {path}"

# 範例 D：公司專屬的 TrustView 加密保護終端包裝器
# [[terminals]]
# name = "trustview-launcher"
# match_env = ["TRUSTVIEW_SESSION"]
# windows_command = "TrustViewLauncher.exe --cwd {path}"

# ------------------------------------------------------------------------------
# 單一全域終端覆寫（選用）：
# 如果你不想用自動識別，希望不論在哪裡按 `wt` 都一律強制執行固定指令，可直接設定 `[terminal]`：
# [terminal]
# mac_command = "open -a 'Company Terminal Launcher' {path}"
# windows_command = "CompanyTerminalLauncher.exe {path}"
# ------------------------------------------------------------------------------

# ==============================================================================
# 第二部分：自訂 Open with 動作 (`[actions]`)
# ==============================================================================

# 範例 1：
# 在選到「資料夾」時，顯示一個 `VSCode` 選項。
# 選到之後會用 macOS 的 Visual Studio Code 開啟該目錄。
#
# 欄位說明：
# - `name`
#   顯示在面板中的名稱。
#   例如 `VSCode`、`Git log`、`Open in Xcode`。
#
# - `scope`
#   這個動作要套用在哪一種類型的目標。
#   可用值：
#   - `file`：只在檔案上顯示
#   - `dir`：只在目錄上顯示
#   - `both`：檔案和目錄都顯示
#
# - `mode`
#   執行方式。
#   可用值：
#   - `detached`：背景執行，不佔用目前 TUI
#   - `terminal`：在終端前景執行，適合 git / svn 這種要看輸出的指令
#
# - `command`
#   所有平台共用的預設指令。
#   如果你沒有寫 `mac_command` 或 `windows_command`，就會使用它。
#
# - `mac_command`
#   只在 macOS 執行的指令，會優先於 `command`。
#
# - `windows_command`
#   只在 Windows 執行的指令，會優先於 `command`。
#
# 可用佔位字串：
# - `{path}`：目前選取項目的完整路徑
# - `{parent}`：目前選取項目的父目錄
# - `{name}`：目前列表中顯示的名稱，含副檔名
# - `{stem}`：檔名去掉副檔名後的部分
#
# 例如：
# - `/Users/otto/work/demo/main.rs`
#   `{path}`   -> `/Users/otto/work/demo/main.rs`
#   `{parent}` -> `/Users/otto/work/demo`
#   `{name}`   -> `main.rs`
#   `{stem}`   -> `main`

[[actions.open_with]]
name = "VSCode"
scope = "dir"
mode = "detached"
mac_command = "open -a 'Visual Studio Code' {path}"
windows_command = "code {path}"

# 範例 2：
# 用 Xcode 開啟資料夾。
# 如果你平常做 Apple 平台開發，可以保留這個範例。
[[actions.open_with]]
name = "Xcode"
scope = "dir"
mode = "detached"
mac_command = "open -a Xcode {path}"

# 範例 3：
# 在檔案或資料夾上執行 git log。
# 因為這個指令通常需要看輸出，所以建議使用 `terminal`。
# 這裡使用 `{parent}`，表示切到該項目的父目錄後再執行 git log。
[[actions.open_with]]
name = "Git log"
scope = "both"
mode = "terminal"
command = "git -C {parent} log --oneline"
windows_command = "git -C {parent} log --oneline"

# 範例 4：
# 只對檔案顯示，使用 Vim 開啟目前檔案。
# 與內建選項同名時，這個外掛定義會覆寫內建動作。
[[actions.open_with]]
name = "Vim"
scope = "file"
mode = "terminal"
command = "vim {path}"

# 範例 5：
# 在 macOS Finder 中顯示目前檔案或資料夾的位置。
# 與內建選項同名時，這個外掛定義會覆寫內建動作。
[[actions.open_with]]
name = "Reveal"
scope = "both"
mode = "detached"
mac_command = "open -R {path}"
